rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  match /resources/{uid}/{allPaths=**} {
   allow read: if request.auth != null && request.auth.uid == '4An1krFPGkcQkoCylVvQyZ2oav52' && uid == request.auth.uid;
   allow write: if request.auth != null && request.auth.uid == '4An1krFPGkcQkoCylVvQyZ2oav52' && uid == request.auth.uid && request.resource != null && request.resource.size <= 10 * 1024 * 1024;
  }
 }
}
